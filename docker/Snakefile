# docker/Snakefile — bash → Snakemake migration (Stage 3: all genes + report).
#
# Wildcard {gene} pipeline covering EVERY gene, routed by genes.tsv support flags:
#   - standard star-allele genes : bcftools + pypgx/stargazer/aldy/stellarpgx
#   - HLA-A / HLA-B / HLA-C      : OptiType (pgx-hla.sh) — NB: one full OptiType run per
#                                  gene, each typing all 3 loci then keeping one. See TODO.
#   - MT-RNR1                    : mutserve (pgx-mt.sh)
#   - GSTT1 (alt contig)        : pypgx (SV, no VCF) + stellarpgx
# Then BAM QC (pgx-bamstats.sh) and the HTML report (pgx-report.py).
#
# Each rule wraps the SAME command pgx-run.sh / pgx-all-genes.sh runs and writes
# the SAME per-gene layout (OUT/genes/<gene>/...), so pgx-compare.py / pgx-report.py
# are unchanged and results match the bash oracle.
#
# NON-FATAL CALLERS (mirrors pgx-run.sh): each caller rule's output is a status
# sentinel holding the real exit code; the rule always succeeds, so one caller
# failing never aborts the gene or the batch. compare reads the sentinels to pass
# --failed-tools and globs whatever real outputs exist.
#
# NOTE: CRAM inputs need pre-extraction to a region BAM (pgx_cram_regions.bed);
# pass --config depth_bam=<extracted.bam> bam=<orig.cram>. Auto-extraction is a
# follow-up; with a BAM input, depth_bam defaults to bam.
#
# Run (inside the container):
#   snakemake -s /opt/pgx/Snakefile --cores 4 \
#       --config bam=/pgx/data/<sample>.bam outdir=/pgx/results
#   # optional: genes="CYP2D6 HLA-A MT-RNR1 GSTT1"   (default: all genes)

import csv
import os
import subprocess

BAM       = config["bam"]
DEPTH_BAM = config.get("depth_bam", BAM)   # for CRAM: the extracted region BAM
REF       = config.get("ref", "/pgx/ref/hg38.fa")
OUT       = config.get("outdir", "/pgx/results")
MINDEP    = config.get("min_depth", 10)
GENES_TSV = config.get("genes_tsv", "/opt/pgx/genes.tsv")

# ── Gene config (single source of truth) ─────────────────────────────────────
with open(GENES_TSV) as _fh:
    GCFG = {r["gene"]: r for r in csv.DictReader(_fh, delimiter="\t")}

def _flag(gene, col):   return GCFG[gene][col] == "1"
def region(gene):       return GCFG[gene]["region"]
def control(gene):      return GCFG[gene]["stargazer_control"]
def pypgx_sv(gene):     return _flag(gene, "pypgx_sv")
def stargazer_sv(gene): return _flag(gene, "stargazer_sv")
def supports(gene, t):  return _flag(gene, t)
def is_alt(gene):       return region(gene) == "ALT_CONTIG"
def needs_vcf(gene):    return (supports(gene, "pypgx") or supports(gene, "stargazer")) and not is_alt(gene)

# Every gene except the CYPOR alias (POR is run).
ALLGENES = sorted(g for g in GCFG if g != "CYPOR")
TARGET = config["genes"].split() if config.get("genes") else ALLGENES

SAMPLE = config.get("sample") or subprocess.run(
    "samtools view -H %s | grep -m1 '^@RG' | grep -oP 'SM:\\K[^\\t]+'" % BAM,
    shell=True, capture_output=True, text=True,
).stdout.strip() or os.path.splitext(os.path.basename(BAM))[0]

BAM_DIR  = os.path.dirname(BAM)
BAM_BASE = os.path.splitext(os.path.basename(BAM))[0]
EXT      = os.path.splitext(BAM)[1].lstrip(".")
IDX_EXT  = "bai" if EXT == "bam" else "crai"

# ── Startup integrity guards — fail loud BEFORE any caller runs ──────────────
# F6: a truncated BAM/CRAM otherwise reads as low coverage (silent NO_CALL).
# F9: a typo'd region / wrong-reference contig naming otherwise reads as NO_CALL.
def _startup_checks():
    if subprocess.run(["samtools", "quickcheck", BAM]).returncode != 0:
        raise RuntimeError(f"samtools quickcheck failed on {BAM} — truncated/corrupt input or missing index")
    fai = REF + ".fai"
    if os.path.exists(fai):
        contigs = {ln.split("\t", 1)[0] for ln in open(fai)}
        for g in TARGET:
            r = region(g)
            if r == "ALT_CONTIG":
                continue
            chrom = r.split(":", 1)[0]
            if chrom not in contigs:
                raise RuntimeError(
                    f"{g}: contig '{chrom}' (from genes.tsv region {r}) not found in {fai} — "
                    f"bad coordinates or a reference with different contig naming")
_startup_checks()

wildcard_constraints:
    gene=r"[A-Z0-9-]+",   # hyphen for HLA-A / HLA-B / MT-RNR1

def G(gene, *parts):
    return os.path.join(OUT, "genes", gene, *parts)

def STAT(gene, tool):
    return G(gene, "logs", f"{tool}.status")


rule all:
    input:
        os.path.join(OUT, f"{SAMPLE}_pgx_report.html"),
        os.path.join(OUT, "all_genes_summary.tsv"),
        os.path.join(OUT, "provenance.json"),
        os.path.join(OUT, ".sanity_ok"),


# ── Standard star-allele callers (non-fatal; output = status sentinel) ────────
rule bcftools:
    output:
        STAT("{gene}", "bcftools"),
    params:
        region=lambda w: region(w.gene),
        vcf=lambda w: G(w.gene, f"{w.gene}.vcf.gz"),
    shell:
        "mkdir -p $(dirname {output}); rc=0; "
        "( bcftools mpileup -r {params.region} -f {REF} -a AD,DP --max-depth 500 -o - {BAM} "
        "| bcftools call -m -v --output-type z -o {params.vcf} && tabix -p vcf {params.vcf} ) "
        "|| rc=$?; echo $rc > {output}"


rule aldy:
    output:
        STAT("{gene}", "aldy"),
    threads: 2
    resources:
        mem_mb=4000
    params:
        real=lambda w: G(w.gene, "aldy", f"{w.gene}.aldy"),
    shell:
        "mkdir -p $(dirname {output}) $(dirname {params.real}); rc=0; "
        "aldy genotype -g {wildcards.gene} -p illumina {BAM} -o {params.real} || rc=$?; "
        "echo $rc > {output}"


rule stellarpgx:
    output:
        STAT("{gene}", "stellarpgx"),
    threads: 2
    resources:
        mem_mb=4000
    params:
        real=lambda w: G(w.gene, "stellarpgx"),
        work=lambda w: G(w.gene, "stellarpgx", ".work"),
        sgene=lambda w: ("cypor" if w.gene.lower() == "por" else w.gene.lower()),
        in_bam=lambda w: f"{BAM_DIR}/{BAM_BASE}*{{{EXT},{IDX_EXT}}}",
    shell:
        "mkdir -p $(dirname {output}) {params.real}; rc=0; "
        "nextflow run /pgx/stellarpgx/main.nf --gene {params.sgene} "
        "--in_bam '{params.in_bam}' --ref_file {REF} --out_dir {params.real} "
        "--res_init /pgx/stellarpgx/resources --db_init /pgx/stellarpgx/database "
        "--caller_init /pgx/stellarpgx/scripts -work-dir {params.work} || rc=$?; "
        "rm -rf {params.work} 2>/dev/null || true; echo $rc > {output}"   # F8: drop Nextflow work tree


# ── Special callers (HLA / MT) — non-fatal ───────────────────────────────────
rule optitype:
    output:
        STAT("{gene}", "optitype"),
    threads: 2
    resources:
        mem_mb=4000
    params:
        outdir=lambda w: G(w.gene),
    shell:
        "mkdir -p $(dirname {output}); rc=0; "
        "pgx-hla.sh {wildcards.gene} {BAM} {SAMPLE} {params.outdir} || rc=$?; "
        "echo $rc > {output}"


rule mutserve:
    output:
        STAT("{gene}", "mutserve"),
    params:
        outdir=lambda w: G(w.gene),
    shell:
        "mkdir -p $(dirname {output}); rc=0; "
        "pgx-mt.sh {BAM} {SAMPLE} {params.outdir} --ref {REF} || rc=$?; "
        "echo $rc > {output}"


# ── OmniGen add-on: HLA class II (sample-level; non-fatal) ───────────────────
# (mtDNA + Y haplogroups were moved to OmniGen — classified downstream from the
# WGS VCFs — so pgx-suite no longer runs them.)
# HLA class II (DQA1/DQB1/DRB1) via arcasHLA — runs ONCE per sample (like PharmCAT).
# Writes hla2/<sample>.genotype.json; per-gene compare reads it (parse_arcashla).
rule hla2:
    output:
        os.path.join(OUT, "hla2", "hla2.status"),
    threads: 4
    resources:
        mem_mb=8000
    params:
        outdir=os.path.join(OUT, "hla2"),
        sif="/pgx/containers/arcashla.sif",
    shell:
        "mkdir -p {params.outdir}; rc=0; "
        "pgx-hla2.sh {BAM} {SAMPLE} {params.outdir} --ref {REF} --sif {params.sif} "
        "|| rc=$?; echo $rc > {output}"


# ── SV preprocessing (hard deps — not callers; failure is a real error) ──────
rule pypgx_depth:
    output:
        G("{gene}", "depth-of-coverage.zip"),
    shell:
        "rm -f {output}; pypgx prepare-depth-of-coverage {output} {BAM} --assembly GRCh38"


rule pypgx_control:
    output:
        G("{gene}", "control-stats-VDR.zip"),
    shell:
        "rm -f {output}; pypgx compute-control-statistics VDR {output} {BAM} --assembly GRCh38"


rule stargazer_gdf:
    output:
        directory(G("{gene}", "stargazer_gdf")),
    params:
        glower=lambda w: w.gene.lower(),
    shell:
        "stargazer -G {params.glower}.gdf -t {params.glower} -c vdr -B {BAM} "
        "-o {output} -a grc38 -d wgs"


# ── VCF-dependent callers (non-fatal) ────────────────────────────────────────
def pypgx_inputs(w):
    ins = {}
    if needs_vcf(w.gene):
        ins["bcftools"] = STAT(w.gene, "bcftools")
    if pypgx_sv(w.gene):
        ins["depth"] = G(w.gene, "depth-of-coverage.zip")
        ins["ctrl"]  = G(w.gene, "control-stats-VDR.zip")
    return ins

rule pypgx_pipeline:
    input:
        unpack(pypgx_inputs),
    output:
        STAT("{gene}", "pypgx"),
    threads: 2
    resources:
        mem_mb=4000
    params:
        outdir=lambda w: G(w.gene, "pypgx"),
        variants=lambda w: (f"--variants {G(w.gene, f'{w.gene}.vcf.gz')}" if needs_vcf(w.gene) else ""),
        sv=lambda w: (
            f"--depth-of-coverage {G(w.gene,'depth-of-coverage.zip')} "
            f"--control-statistics {G(w.gene,'control-stats-VDR.zip')}"
            if pypgx_sv(w.gene) else ""),
    shell:
        "mkdir -p $(dirname {output}); rc=0; "
        "pypgx run-ngs-pipeline {wildcards.gene} {params.outdir} --assembly GRCh38 "
        "--force {params.variants} {params.sv} || rc=$?; echo $rc > {output}"


def stargazer_inputs(w):
    ins = {"bcftools": STAT(w.gene, "bcftools")}
    if stargazer_sv(w.gene):
        ins["gdf_dir"] = G(w.gene, "stargazer_gdf")
    return ins

rule stargazer_genotype:
    input:
        unpack(stargazer_inputs),
    output:
        STAT("{gene}", "stargazer"),
    params:
        outdir=lambda w: G(w.gene, "stargazer"),
        glower=lambda w: w.gene.lower(),
        vcf=lambda w: G(w.gene, f"{w.gene}.vcf.gz"),
        mode=lambda w: (
            f"-c vdr -g {G(w.gene,'stargazer_gdf',w.gene.lower()+'.gdf')}"
            if stargazer_sv(w.gene)
            else (f"-c {control(w.gene)}" if control(w.gene) != "-" else "")),
    shell:
        "mkdir -p $(dirname {output}); rc=0; "
        "stargazer -t {params.glower} -d wgs -a grc38 -i {params.vcf} "
        "-o {params.outdir} {params.mode} || rc=$?; echo $rc > {output}"


# Cyrius: SV-aware CYP2D6 caller (resolves 2D6/2D7 paralog + CNV/hybrids the
# star-allele callers miss). Vendored at /opt/cyrius; non-fatal sentinel.
rule cyrius:
    output:
        STAT("{gene}", "cyrius"),
    threads: 2
    resources:
        mem_mb=4000
    params:
        outdir=lambda w: G(w.gene, "cyrius"),
    shell:
        "mkdir -p {params.outdir} $(dirname {output}); rc=0; "
        "echo {BAM} > {params.outdir}/manifest.txt; "
        "python3 /opt/cyrius/star_caller.py --manifest {params.outdir}/manifest.txt "
        "--genome 38 --reference {REF} --prefix {SAMPLE} --outDir {params.outdir} "
        "--threads {threads} || rc=$?; echo $rc > {output}"


# PharmCAT: CPIC reference implementation, run ONCE per sample via its Apptainer
# SIF (carries its own bcftools >=1.18 + jar + preprocessor + positions). Produces
# one report.json covering all its CPIC genes; per-gene compare reads its gene out.
# GT-only positions VCF avoids the AD/DP FORMAT-merge conflict PharmCAT chokes on.
rule pharmcat:
    output:
        os.path.join(OUT, "pharmcat", "pharmcat.status"),
    threads: 4
    resources:
        mem_mb=6000
    params:
        pcdir=os.path.join(OUT, "pharmcat"),
        positions="/opt/pgx/pharmcat_positions.vcf.bgz",
        sif="/pgx/containers/pharmcat.sif",
    shell:
        "mkdir -p {params.pcdir}; rc=0; "
        "( bcftools mpileup -R {params.positions} -f {REF} --max-depth 500 -Ou {BAM} 2>/dev/null "
        "| bcftools call -m --output-type z -o {params.pcdir}/pgx.vcf.gz "
        "&& tabix -f -p vcf {params.pcdir}/pgx.vcf.gz "
        # --cleanenv: the runtime image exports JAVA_HOME=/usr/lib/jvm/java-21
        # which would otherwise leak into the SIF (whose JDK is temurin-17 at
        # /usr/bin/java), making pharmcat_pipeline look for a java that isn't there.
        "&& apptainer exec --cleanenv --bind {params.pcdir}:{params.pcdir} {params.sif} "
        "pharmcat_pipeline {params.pcdir}/pgx.vcf.gz --missing-to-ref -reporterJson -o {params.pcdir} ) "
        "|| rc=$?; echo $rc > {output}"


# ── ALT-awareness check (sample-level; gates paralog/SV genes) ───────────────
# A non-ALT-aware alignment (minimap2, or a no-ALT reference) mis-distributes
# reads across 2D6/2D7 + ALT contigs -> false CYP2D6 *5 etc. compare reads this
# verdict and NO_CALLs alt-sensitive genes when it isn't "yes".
rule altcheck:
    output:
        os.path.join(OUT, "alt_aware.json"),
    shell:
        "python3 /opt/pgx/pgx_altcheck.py {BAM} > {output}"


# ── Phase 3: reconcile (single verdict authority; always runs) ───────────────
def compare_inputs(w):
    g = w.gene
    ins = {"altcheck": os.path.join(OUT, "alt_aware.json")}
    for tool in ("pypgx", "stargazer", "aldy", "stellarpgx", "optitype", "mutserve", "cyrius"):
        if supports(g, tool):
            ins[tool] = STAT(g, tool)
    if needs_vcf(g) or _flag(g, "vcf_check"):
        ins["bcftools"] = STAT(g, "bcftools")
    if _flag(g, "pharmcat"):   # sample-level dependency; PharmCAT runs once
        ins["pharmcat"] = os.path.join(OUT, "pharmcat", "pharmcat.status")
    if _flag(g, "arcashla"):   # sample-level dependency; arcasHLA types all HLA once
        ins["hla2"] = os.path.join(OUT, "hla2", "hla2.status")
    return ins

rule compare:
    input:
        unpack(compare_inputs),
    output:
        G("{gene}", "{gene}_" + SAMPLE + "_detail.json"),
    params:
        region=lambda w: region(w.gene),
        is_alt=lambda w: is_alt(w.gene),
        outdir=lambda w: G(w.gene),
        logdir=lambda w: G(w.gene, "logs"),
    run:
        names = {"pypgx": "PyPGx", "stargazer": "Stargazer", "aldy": "Aldy",
                 "stellarpgx": "StellarPGx", "optitype": "OptiType", "mutserve": "mutserve",
                 "cyrius": "Cyrius"}
        failed = []
        for key, name in names.items():
            sf = os.path.join(params.logdir, f"{key}.status")
            if os.path.exists(sf) and open(sf).read().strip() not in ("0", ""):
                failed.append(name)
        args = (f"--gene {wildcards.gene} --sample {SAMPLE} "
                f"--output-dir {params.outdir} --min-depth {MINDEP}")
        if not params.is_alt:   # alt-contig genes (GSTT1) have no measurable region depth
            depth = subprocess.run(
                f"samtools coverage -r {params.region} --reference {REF} {BAM} "
                f"| awk 'NR==2 {{print $7}}'",
                shell=True, capture_output=True, text=True).stdout.strip()
            if depth:
                args += f" --region-depth {depth}"
        if failed:
            args += " --failed-tools " + ",".join(failed)
        import json as _json
        alt_aware = "yes"
        try:
            alt_aware = _json.load(open(os.path.join(OUT, "alt_aware.json"))).get("alt_aware", "yes")
        except Exception:
            pass
        args += f" --alt-aware {alt_aware}"
        shell(f"python3 /opt/pgx/pgx-compare.py {args}")


# ── BAM QC + HTML report ─────────────────────────────────────────────────────
rule bamstats:
    output:
        os.path.join(OUT, "bam_stats.json"),
    threads: 4
    resources:
        mem_mb=2000
    shell:
        # pgx-bamstats.sh <orig_bam> <sample> <log_dir> <ref> <depth_bam>
        "pgx-bamstats.sh {BAM} {SAMPLE} {OUT} {REF} {DEPTH_BAM}"


rule report:
    input:
        details=[G(g, f"{g}_{SAMPLE}_detail.json") for g in TARGET],
        bamstats=os.path.join(OUT, "bam_stats.json"),
        provenance=os.path.join(OUT, "provenance.json"),
        summary=os.path.join(OUT, "all_genes_summary.tsv"),   # report reads this; make the dep explicit
    output:
        os.path.join(OUT, f"{SAMPLE}_pgx_report.html"),
    shell:
        "pgx-report.py --sample {SAMPLE} --output {OUT} "
        "--genes-dir {OUT}/genes --bam {BAM} --bam-stats {input.bamstats} "
        "--provenance {input.provenance}"


# ── Verdict-driven summary (replaces the pgx-all-genes.sh awk loop) ───────────
rule all_genes_summary:
    input:
        [G(g, f"{g}_{SAMPLE}_detail.json") for g in TARGET],
    output:
        os.path.join(OUT, "all_genes_summary.tsv"),
    run:
        import json
        with open(output[0], "w") as out:
            out.write("Gene\tStatus\tConsensusDiplotype\tConsensusPhenotype\t"
                      "nAgree\tnCalled\tMeanDepth\n")
            for f in sorted(input):
                d = json.load(open(f))
                v = d.get("verdict", {})
                cov = d.get("coverage", {})
                out.write("\t".join(str(x) for x in [
                    d["gene"], v.get("status", "?"), v.get("consensus_diplotype", "-"),
                    v.get("consensus_phenotype", "-"), v.get("n_agree", 0),
                    v.get("n_called", 0), cov.get("mean_depth", "-"),
                ]) + "\n")


# ── F2: run-level provenance (tool versions, reference, timestamp) ───────────
rule provenance:
    output:
        os.path.join(OUT, "provenance.json"),
    run:
        import json, datetime
        def first_line(cmd):
            # encoding/errors guard against tools that emit non-UTF-8 bytes;
            # skip warning/traceback/source-path lines so we land on the real version.
            try:
                r = subprocess.run(cmd, shell=True, capture_output=True,
                                   encoding="utf-8", errors="replace", timeout=60)
                out = (r.stdout or r.stderr or "").strip()
                for ln in out.splitlines():
                    s = ln.strip()
                    low = s.lower()
                    if not s or "warning" in low or "traceback" in low \
                       or s.startswith('File "') or '.py:' in s:
                        continue
                    return s
                return out.splitlines()[0] if out else "unknown"
            except Exception as e:
                return f"unavailable ({e.__class__.__name__})"
        ref_fai = REF + ".fai"
        prov = {
            "pipeline": (open("/opt/pgx/VERSION").read().strip()
                         if os.path.exists("/opt/pgx/VERSION") else "unknown"),
            "generated_utc": datetime.datetime.utcnow().isoformat(timespec="seconds") + "Z",
            "sample": SAMPLE,
            "reference": {
                "path": REF,
                "bytes": os.path.getsize(REF) if os.path.exists(REF) else None,
                "n_contigs": (sum(1 for _ in open(ref_fai)) if os.path.exists(ref_fai) else None),
            },
            "genes_assessed": len(TARGET),
            "tools": {
                "pypgx": first_line("python3 -c \"import importlib.metadata as m; print(m.version('pypgx'))\""),
                "aldy": first_line("python3 -c \"import importlib.metadata as m; print(m.version('aldy'))\""),
                "stargazer": first_line("PYTHONWARNINGS=ignore stargazer --version 2>&1"),
                "stellarpgx": "1.2.7 (image)",
                "optitype": "1.3.5 (image)",
                "mutserve": "2.0.0 (image)",
                "samtools": first_line("samtools --version 2>&1"),
                "bcftools": first_line("bcftools --version 2>&1"),
                "snakemake": first_line("snakemake --version 2>&1"),
            },
        }
        with open(output[0], "w") as fh:
            json.dump(prov, fh, indent=2)


# ── F1: fail loud if a misconfigured run produced mostly non-calls ───────────
# Non-fatal callers mean a wrong reference / unreadable BAM otherwise yields an
# all-NO_CALL report and exit 0. This gate flips that to a non-zero exit (the
# report is still written for inspection) so a broken run can't pass silently.
rule sanity_gate:
    input:
        os.path.join(OUT, "all_genes_summary.tsv"),
    output:
        os.path.join(OUT, ".sanity_ok"),
    run:
        import sys
        rows = [ln.split("\t") for ln in open(input[0]).read().splitlines()[1:] if ln.strip()]
        total = len(rows)
        bad = sum(1 for r in rows if len(r) > 1 and r[1] in ("no_call", "no_data"))
        frac = (bad / total) if total else 1.0
        if total == 0 or frac > 0.6:
            sys.stderr.write(
                f"SANITY FAIL: {bad}/{total} genes are no_call/no_data ({frac:.0%}). "
                "Likely a misconfigured run (wrong reference, unreadable BAM, or wholesale "
                "low coverage). The HTML report was still written for inspection.\n")
            sys.exit(1)
        with open(output[0], "w") as fh:
            fh.write(f"ok: {total - bad}/{total} genes called\n")
