// pgx-suite Nextflow configuration (port of docker/Snakefile; docs/nextflow-port-plan.md)

manifest {
    name            = 'pgx-suite'
    description     = 'Multi-caller pharmacogenomics genotyping from a GRCh38 WGS BAM/CRAM'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

params {
    bam            = null      // indexed BAM/CRAM (host path)
    depth_bam      = null      // CRAM only: region BAM in the same folder, used for depth (as in the Snakefile)
    sample         = null
    sex            = null      // MALE | FEMALE; else inferred (G6PD)
    ref            = null      // GRCh38 FASTA with .fai, the one the BAM was aligned to
    genes          = null      // subset, space- or comma-separated; default: all genes in genes_tsv
    genes_tsv      = "${projectDir}/docker/genes.tsv"
    min_depth      = 10
    outdir         = 'results'
    publish_mode   = 'copy'
    pgx_image      = 'pgx-suite:latest'
    pypgx_bundle   = "${projectDir}/pypgx/pypgx-bundle"
    stellarpgx_dir = "${projectDir}/StellarPGx"
    containers_dir = "${projectDir}/StellarPGx/containers"
    max_cpus       = 8
    max_memory     = '32 GB'
    max_time       = '24h'
    max_mem_total  = null      // GB budget for all concurrent steps (OmniGen: its --mem share); default max_memory
}

process {
    container      = params.pgx_image
    cpus           = 1
    memory         = { 2.GB * task.attempt }   // every step: x attempt on a retry
    cache          = 'lenient'
    // 134 abort / 137 SIGKILL (OOM): retry with memory x attempt, then stop the run.
    // 143 (SIGTERM: qdel, soft limit) and 140 (time) are NOT retried: more memory does not help, the run stops at once.
    // Both are still gated as a kill by bin/nf_kill_gate.sh, never silent.
    errorStrategy  = { task.exitStatus in [134, 137] && task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries     = 2
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory as MemoryUnit, time: params.max_time as Duration]
    // Apptainer runs inside these containers (OptiType, PharmCAT, nested StellarPGx); nothing else is privileged.
    withLabel: 'nested_apptainer' { containerOptions = '--privileged' }
}

executor {
    cpus   = params.max_cpus as int
    // the local executor admits steps while the sum of their memory fits: without this it over-commits host RAM
    memory = (params.max_mem_total ? "${params.max_mem_total} GB".toString() : params.max_memory.toString()) as MemoryUnit
}

// Containers run as the invoking user, never root. run_pgx_suite.sh exports PGX_DOCKER_USER_OPTS (built by
// docker/run_as_user.sh from OG_DOCKER_USER); when nextflow is launched directly the same script builds it
// here. An empty PGX_DOCKER_USER_OPTS is the explicit opt-out (root). The script fails (and so does this
// config) if uid/gid cannot be determined or OG_DOCKER_USER is invalid, rather than building "--user :".
def runAsUser
if (System.getenv('PGX_DOCKER_USER_OPTS') != null) {
    runAsUser = System.getenv('PGX_DOCKER_USER_OPTS')
} else {
    def proc = new ProcessBuilder('bash', "${projectDir}/docker/run_as_user.sh".toString()).redirectErrorStream(true).start()
    def out = proc.inputStream.text.trim()
    if (proc.waitFor() != 0) {
        throw new IllegalStateException("cannot build the run-as-user docker options: ${out}")
    }
    runAsUser = out
}

profiles {
    test {
        // the smoke-test slice (tests/smoke): 4 genes, reference from ./GRCh38
        params.bam    = "${projectDir}/tests/smoke/data/HG002.smoke.bam"
        params.sample = 'HG002'
        params.ref    = "${projectDir}/GRCh38/hg38.fa"
        params.genes  = 'CYP2C19 CYP3A5 NAT2 VKORC1'
        params.outdir = "${projectDir}/results/nf_test"
    }
    docker {
        docker.enabled = true
        // Same container paths as run_pgx_suite.sh, so every script and output path matches the Snakemake run.
        docker.runOptions = [
            runAsUser,
            // bin/nf_stage.sh replaces /pgx/results with a symlink; /pgx is root-owned in the image, so a
            // non-root task needs a writable /pgx. The -v mounts below are nested inside this tmpfs.
            '--tmpfs /pgx:mode=0777',
            "-v ${params.stellarpgx_dir}:/pgx/stellarpgx",
            "-v ${params.containers_dir}:/pgx/containers",
            "-v ${params.pypgx_bundle}:/pgx/bundle",
            params.ref ? "-v ${new File(params.ref.toString()).getAbsoluteFile().parent}:/pgx/ref:ro" : '',
            params.bam ? "-v ${new File(params.bam.toString()).getAbsoluteFile().parent}:/pgx/data:ro" : '',
        ].join(' ')
    }
}

def trace_dir = "${params.outdir}/${params.sample}/pipeline_info"
timeline { enabled = true; file = "${trace_dir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${trace_dir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${trace_dir}/trace.txt";     overwrite = true }
